{
  "name": "writee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:desktop": "npm run build",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "e2e:desktop": "node e2e/desktop.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "node e2e/run-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
